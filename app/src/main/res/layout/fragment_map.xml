<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Navigation Status Box -->
    <TextView
        android:id="@+id/mapNavigationStatusBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@android:color/holo_blue_light"
        android:text="No destination selected"
        android:textSize="@dimen/instruction_text_size"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:padding="@dimen/stats_padding"
        android:textAlignment="center"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Step Count and Distance Display -->
    <LinearLayout
        android:id="@+id/mapStepDistanceLayout"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:background="@android:color/holo_green_light"
        android:padding="@dimen/stats_padding"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/mapNavigationStatusBox"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/mapStepCountDisplay"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Steps: 0"
            android:textSize="@dimen/stats_text_size"
            android:textColor="@android:color/white"
            android:gravity="center" />

        <TextView
            android:id="@+id/mapDistanceDisplay"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Distance: 0.0m"
            android:textSize="@dimen/stats_text_size"
            android:textColor="@android:color/white"
            android:gravity="center" />

    </LinearLayout>

    <!-- Navigation Instructions -->
    <TextView
        android:id="@+id/mapInstructionBox"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/teal_200"
        android:text="Map View"
        android:textSize="@dimen/instruction_text_size"
        android:padding="@dimen/stats_padding"
        android:textAlignment="center"
        android:textColor="@android:color/white"
        app:layout_constraintTop_toBottomOf="@id/mapStepDistanceLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <!-- Map Container -->
    <com.example.finalprototype.RouteMapView
        android:id="@+id/routeMapView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toBottomOf="@id/mapInstructionBox"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

</androidx.constraintlayout.widget.ConstraintLayout>
